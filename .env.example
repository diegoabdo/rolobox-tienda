APP_NAME="Twist & Rolls"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="pedidos@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Twist & Rolls ---
# Zona horaria en la que se muestran fechas y se calculan los horarios de entrega.
ROLOBOX_TIMEZONE=America/Guatemala
# Número de WhatsApp de atención (solo dígitos, con código de país).
ROLOBOX_WHATSAPP=50200000000
ROLOBOX_CONTACT_EMAIL=lorenaestrada@hotmail.com
# Versión vigente de términos y aviso de privacidad. Cámbiala cada vez que publiques una versión nueva.
ROLOBOX_LEGAL_VERSION=2026-11-01-v1
# Razón social responsable del sitio (aparece en términos y privacidad).
ROLOBOX_LEGAL_ENTITY=Unique
# true = las páginas legales muestran el aviso de borrador.
ROLOBOX_LEGAL_DRAFT=true
# Días de anticipación mínimos para el reparto local.
ROLOBOX_MIN_LEAD_DAYS=1

# Procesador de pagos: "fake" (simulado, solo desarrollo) o "recurrente".
PAYMENTS_DRIVER=fake
RECURRENTE_SECRET_KEY=
# Secreto del endpoint de webhooks (empieza con whsec_).
RECURRENTE_WEBHOOK_SECRET=
RECURRENTE_BASE_URL=https://app.recurrente.com/api

# SSR de Inertia: apagado en desarrollo (más rápido); encenderlo en producción.
INERTIA_SSR_ENABLED=false
